{
  "name": "@snappli/sdk",
  "version": "0.3.0",
  "description": "SDK de Snappli para integradores: verifica webhooks, descarga documentos, envía eventos de conector y lee la API pública.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://docs.snappli.io/desarrolladores/herramientas/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snappli/snappli-cli.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/Snappli/snappli-cli/issues",
  "keywords": [
    "snappli",
    "webhooks",
    "whatsapp",
    "crm",
    "sdk"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
