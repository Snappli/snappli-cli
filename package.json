{
  "name": "snappli-cli-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@snappli/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"@snappli/*\" run test",
    "test:examples": "pnpm -r --filter \"@snappli-examples/*\" run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sync:shared": "node scripts/sync-shared.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
